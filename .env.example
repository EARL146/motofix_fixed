# Copy this file to .env and fill in your existing MotoFix values.
# Do NOT commit .env or publish API keys.
PORT=3000
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@gmail.com

# TikTok Login Kit (Web)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_new_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.app/api/auth/tiktok/callback

# Comma-separated admin allowlist (exactly these two accounts)
ADMIN_EMAILS=admin@gmail.com,earlypajo050775@gmail.com
